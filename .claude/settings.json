{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Edit(LeanEuclidPlus/Book/**)",
      "Write(LeanEuclidPlus/Book/**)",
      "Edit(LeanEuclidPlus/Book2/**)",
      "Write(LeanEuclidPlus/Book2/**)",

      "Bash(lake env:*)",
      "Bash(lake exe faithful_export:*)",
      "Bash(mkdir:*)",
      "Bash(rm:*)",

      "Edit(LeanEuclidPlus/Book1/**)",
      "Write(LeanEuclidPlus/Book1/**)",

      "Edit(.claude/skills/faithful-patterns/**)",
      "Write(.claude/skills/faithful-patterns/**)",


      "Bash(realpath:*)",
      "Bash(dirname:*)",
      "Bash(basename:*)",
      "Bash(pwd)",
      "Bash(cd:*)",
      "Bash(echo:*)",

      "Bash(grep:*)",
      "Bash(egrep:*)",
      "Bash(fgrep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(wc:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git blame:*)",

      "Bash(python scripts/check_faithful.py:*)",
      "Bash(python3 scripts/check_faithful.py:*)",
      "Bash(scripts/check_faithful.sh:*)",
      "Bash(./scripts/check_faithful.sh:*)",
      "Bash(python scripts/check_signatures.py:*)",
      "Bash(python3 scripts/check_signatures.py:*)",
      "Bash(python scripts/check_steps.py:*)",
      "Bash(python3 scripts/check_steps.py:*)",
      "Bash(python scripts/check_step.py:*)",
      "Bash(python3 scripts/check_step.py:*)",
      "Bash(python scripts/wire_main.py:*)",
      "Bash(python3 scripts/wire_main.py:*)",
      "Bash(python scripts/smt_probe.py:*)",
      "Bash(python3 scripts/smt_probe.py:*)",
      "Bash(python scripts/find.py:*)",
      "Bash(python3 scripts/find.py:*)",
      "Bash(python scripts/bake_index.py:*)",
      "Bash(python3 scripts/bake_index.py:*)",
      "Bash(python scripts/scaffold_step.py:*)",
      "Bash(python3 scripts/scaffold_step.py:*)",
      "Bash(python -m pytest:*)",
      "Bash(python3 -m pytest:*)"
    ],
    "deny": [
      "Bash(scripts/safe_build.sh:*)",
      "Bash(./scripts/safe_build.sh:*)",
      "Bash(lake build:*)",

      "Write(**/step_signatures.json)",
      "Edit(**/step_signatures.json)",
      "Write(**/proposition_signatures.json)",
      "Edit(**/proposition_signatures.json)",
      "Write(**/assumption_tags.json)",
      "Edit(**/assumption_tags.json)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git restore:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git stash:*)",

      "Edit(LeanEuclidPlus/OldBook1/**)",
      "Write(LeanEuclidPlus/OldBook1/**)",
      "Edit(LeanEuclidPlus/OldBook1Variants/**)",
      "Write(LeanEuclidPlus/OldBook1Variants/**)",
      "Edit(LeanEuclidPlus/OldBook1.lean)",
      "Write(LeanEuclidPlus/OldBook1.lean)",
      "Edit(LeanEuclidPlus/OldBook1Variants.lean)",
      "Write(LeanEuclidPlus/OldBook1Variants.lean)"
    ],
    "ask": [
      "Edit(LeanEuclidPlus/SystemE/**)",
      "Write(LeanEuclidPlus/SystemE/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /h/56/taddmao/code/autoform/DNA/.claude/hooks/bash_hygiene.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /h/56/taddmao/code/autoform/DNA/.claude/hooks/step_order_hook.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /h/56/taddmao/code/autoform/DNA/.claude/hooks/step_order_hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
