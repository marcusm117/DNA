
{
    "quantification": "omitted since we will use the binder form",
    "premises": [
        "(U : Set ℂ)",
        "(hU_1 : Nonempty U)",
        "(hU_2 : IsConnected U)",
        "(hU_3 : IsOpen U)",
        "(f_n : ℕ → ℂ → ℂ)",
        "(hf_n_1 : ∀ i : ℕ, DifferentiableOn ℂ (f_n i) U)",
        "(f : ℂ → ℂ)",
        "(hf_1 : ∀ X : Set ℂ, X ⊆ U ∧ IsCompact X → TendstoUniformlyOn (λ n x => f_n n x) f atTop X)",
    ],
    "conclusions": [
        "DifferentiableOn ℂ f U",
    ]
}














